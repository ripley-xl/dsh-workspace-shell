{
  "name": "@local/dsh-workspace-shell-guest-cwd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scalar effective-cwd companion for plugin-owned embedded Web Guests",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  }
}
