{
  "name": "dsh-workspace-shell-guest-notify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Notification bridge companion for plugin-owned remote Web Guests",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  }
}
