{
  "name": "dsh-workspace-shell",
  "version": "0.5.16",
  "private": true,
  "type": "module",
  "description": "Plugin-only multi-profile workspace frame for DeepSeek Harness",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/**/*.js",
    "cordis.patch.yml",
    "guest-cwd/index.js",
    "guest-cwd/client.js",
    "guest-cwd/cordis.patch.yml",
    "guest-cwd/package.json",
    "session-host/*.js",
    "locale/*.json",
    "icon.svg",
    "assets/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  },
  "dependencies": {
    "@local/dsh-ssh-remote": "file:../manager"
  }
}
